# Satarupa Steel Enterprise - Environment Configuration
# Copy this file to .env and fill in your real Firebase project values.
# NEVER commit a .env file with real credentials — it is listed in .gitignore.
# For Vercel: add each variable below in Project Settings → Environment Variables.

# ── Firebase Config (required for all environments) ────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# ── Admin Access Control ────────────────────────────────────────────────────
# Comma-separated list of Google email addresses allowed to access /admin.
# Example: VITE_ADMIN_EMAILS=you@gmail.com,partner@gmail.com
VITE_ADMIN_EMAILS=

# ── Image Upload ────────────────────────────────────────────────────────────
# Optional: override the built-in ImgBB API key
VITE_IMGBB_API_KEY=7bae973fc21e5a2cc665dbe3411995a4


